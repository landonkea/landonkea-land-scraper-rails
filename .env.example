# Copy this file to .env and fill in real values. .env is gitignored on purpose — it's
# where actual secrets live locally. This file (.env.example) has no real secrets in it,
# which is exactly why it's safe to commit and check into git.

# The Discord webhook URL the scraper posts new/promising listings to. Create one in
# Discord under Server Settings -> Integrations -> Webhooks -> New Webhook, then paste
# the URL it gives you here. Leave it blank locally and the app just logs listings to
# the console/log file instead of posting them anywhere.
DISCORD_WEBHOOK_URL=
